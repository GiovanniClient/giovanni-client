{
  "schemaVersion": 1,
  "id": "giovanniclient",
  "version": "${version}",
  "name": "GiovanniClient",
  "description": "Team Rocket blasts off at the speed of light!",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/giovanniclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "rocket.giovanniclient.client.GiovanniClientDataGenerator"
    ],
    "client": [
      "rocket.giovanniclient.client.GiovanniClientClient"
    ],
    "rei_client": [
      "rocket.giovanniclient.client.features.inventorybuttons.rei.GiovanniReiPlugin"
    ]
  },
  "mixins": [
    "giovanniclient.main.mixins.json",
    {
      "config": "giovanniclient.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "wurst.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=1.13.9+kotlin.2.3.10",
    "minecraft": ">=${minecraft_version}"
  },
  "custom": {
    "firmament:hide_from_modlist": true
  }
}
